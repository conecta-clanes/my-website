# ── Backend a usar ────────────────────────────────────────────────────────────
# Opciones: claude | openai | gemini | kimi | glm | ollama
LLM_BACKEND=claude

# Número de documentos a incluir por consulta (default: 6)
DOCS_TOP_K=6

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── ChatGPT (OpenAI) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1   # cambiar para servidores compatibles

# ── Gemini (Google) ───────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# ── Kimi (Moonshot AI) ────────────────────────────────────────────────────────
KIMI_API_KEY=sk-...
KIMI_MODEL=moonshot-v1-128k

# ── GLM (Zhipu AI) ────────────────────────────────────────────────────────────
GLM_API_KEY=...
GLM_MODEL=glm-4-flash

# ── Ollama (local, sin API key) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
